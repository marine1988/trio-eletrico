# Fallback de headers para Netlify (usado por netlify dev e CDN)
# A compressão real (brotli/gzip) é aplicada automaticamente pela CDN do Netlify.
# Este ficheiro define Content-Type, Vary e Cache-Control por tipo de asset.

/*.html
  Content-Type: text/html; charset=utf-8
  Vary: Accept-Encoding
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Content-Type: text/css; charset=utf-8
  Vary: Accept-Encoding
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Content-Type: application/javascript; charset=utf-8
  Vary: Accept-Encoding
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Content-Type: image/svg+xml
  Vary: Accept-Encoding
  Cache-Control: public, max-age=31536000, immutable

/*.json
  Content-Type: application/json; charset=utf-8
  Vary: Accept-Encoding
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable
